MERGE (n:KhaiNiem {ten: "Đồng xử lý chất thải"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 21", n.noi_dung = "là việc kết hợp một quá trình sản xuất sẵn có để tái chế, xử lý, thu hồi năng lượng từ chất thải, trong đó chất thải được sử dụng làm nguyên liệu, vật liệu, nhiên liệu thay thế hoặc được xử lý.", n.chuong = "Chương I", n.keyphrase = "Kết hợp quá trình sản xuất sẵn có để tái chế/xử lý/thu hồi năng lượng." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 21", n.noi_dung = "là việc kết hợp một quá trình sản xuất sẵn có để tái chế, xử lý, thu hồi năng lượng từ chất thải, trong đó chất thải được sử dụng làm nguyên liệu, vật liệu, nhiên liệu thay thế hoặc được xử lý.";
MERGE (n:KhaiNiem {ten: "Kiểm soát ô nhiễm"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 22", n.noi_dung = "là quá trình phòng ngừa, phát hiện, ngăn chặn và xử lý ô nhiễm.", n.chuong = "Chương I", n.keyphrase = "Phòng ngừa, phát hiện, ngăn chặn và xử lý ô nhiễm." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 22", n.noi_dung = "là quá trình phòng ngừa, phát hiện, ngăn chặn và xử lý ô nhiễm.";
MERGE (n:KhaiNiem {ten: "Khả năng chịu tải của môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 23", n.noi_dung = "là giới hạn chịu đựng của môi trường đối với các nhân tố tác động để môi trường có thể tự phục hồi.", n.chuong = "Chương I", n.keyphrase = "Giới hạn chịu đựng của môi trường để tự phục hồi." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 23", n.noi_dung = "là giới hạn chịu đựng của môi trường đối với các nhân tố tác động để môi trường có thể tự phục hồi.";
