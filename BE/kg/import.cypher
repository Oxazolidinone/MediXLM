MERGE (n:KhaiNiem {ten: "Quan trắc môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 25", n.noi_dung = "là việc theo dõi liên tục, định kỳ, đột xuất, có hệ thống về thành phần môi trường, các nhân tố tác động đến môi trường, chất thải nhằm cung cấp thông tin đánh giá hiện trạng môi trường, diễn biến chất lượng môi trường và tác động xấu đến môi trường.", n.chuong = "Chương I", n.keyphrase = "Theo dõi liên tục, định kỳ, đột xuất thành phần môi trường/chất thải." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 25", n.noi_dung = "là việc theo dõi liên tục, định kỳ, đột xuất, có hệ thống về thành phần môi trường, các nhân tố tác động đến môi trường, chất thải nhằm cung cấp thông tin đánh giá hiện trạng môi trường, diễn biến chất lượng môi trường và tác động xấu đến môi trường.";
MERGE (n:KhaiNiem {ten: "Vận hành thử nghiệm công trình xử lý chất thải"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 26", n.noi_dung = "là việc vận hành nhằm kiểm tra, đánh giá hiệu quả và sự phù hợp với yêu cầu về bảo vệ môi trường đối với công trình xử lý chất thải của chủ dự án đầu tư, cơ sở, khu sản xuất, kinh doanh, dịch vụ tập trung, cụm công nghiệp.", n.chuong = "Chương I", n.keyphrase = "Vận hành kiểm tra, đánh giá hiệu quả công trình xử lý chất thải." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 26", n.noi_dung = "là việc vận hành nhằm kiểm tra, đánh giá hiệu quả và sự phù hợp với yêu cầu về bảo vệ môi trường đối với công trình xử lý chất thải của chủ dự án đầu tư, cơ sở, khu sản xuất, kinh doanh, dịch vụ tập trung, cụm công nghiệp.";
