MERGE (n:KhaiNiem {ten: "Thiệt hại do ô nhiễm, suy thoái môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 130, Khoản 1", n.noi_dung = "bao gồm: a) Suy giảm chức năng, tính hữu ích của môi trường; b) Thiệt hại về tính mạng, sức khỏe của con người, tài sản và lợi ích hợp pháp của tổ chức, cá nhân do hậu quả của việc suy giảm chức năng, tính hữu ích của môi trường gây ra.", n.chuong = "Chương X", n.keyphrase = "Suy giảm chức năng/tính hữu ích; Thiệt hại về sức khỏe, tài sản" ON MATCH SET n.dieu_khoan = "Điều 130, Khoản 1", n.noi_dung = "bao gồm: a) Suy giảm chức năng, tính hữu ích của môi trường; b) Thiệt hại về tính mạng, sức khỏe của con người, tài sản và lợi ích hợp pháp của tổ chức, cá nhân do hậu quả của việc suy giảm chức năng, tính hữu ích của môi trường gây ra.";
MERGE (n:KhaiNiem {ten: "Chi trả dịch vụ hệ sinh thái tự nhiên"}) ON CREATE SET n.dieu_khoan = "Điều 138, Khoản 1", n.noi_dung = "là việc tổ chức, cá nhân sử dụng dịch vụ hệ sinh thái tự nhiên trả tiền cho tổ chức, cá nhân cung ứng giá trị môi trường, cảnh quan do hệ sinh thái tự nhiên tạo ra để bảo vệ, duy trì và phát triển hệ sinh thái tự nhiên.", n.chuong = "Chương XI", n.keyphrase = "Sử dụng dịch vụ HSTT trả tiền; Bảo vệ, duy trì và phát triển HSTT" ON MATCH SET n.dieu_khoan = "Điều 138, Khoản 1", n.noi_dung = "là việc tổ chức, cá nhân sử dụng dịch vụ hệ sinh thái tự nhiên trả tiền cho tổ chức, cá nhân cung ứng giá trị môi trường, cảnh quan do hệ sinh thái tự nhiên tạo ra để bảo vệ, duy trì và phát triển hệ sinh thái tự nhiên.";
MERGE (n:KhaiNiem {ten: "Thị trường các-bon trong nước"}) ON CREATE SET n.dieu_khoan = "Điều 139, Khoản 1", n.noi_dung = "gồm các hoạt động trao đổi hạn ngạch phát thải khí nhà kính và tín chỉ các-bon thu được từ cơ chế trao đổi, bù trừ tín chỉ các-bon trong nước và quốc tế phù hợp với quy định của pháp luật và điều ước quốc tế mà nước Cộng hòa xã hội chủ nghĩa Việt Nam là thành viên.", n.chuong = "Chương XI", n.keyphrase = "Trao đổi hạn ngạch và tín chỉ các-bon; Cơ chế trao đổi, bù trừ" ON MATCH SET n.dieu_khoan = "Điều 139, Khoản 1", n.noi_dung = "gồm các hoạt động trao đổi hạn ngạch phát thải khí nhà kính và tín chỉ các-bon thu được từ cơ chế trao đổi, bù trừ tín chỉ các-bon trong nước và quốc tế phù hợp với quy định của pháp luật và điều ước quốc tế mà nước Cộng hòa xã hội chủ nghĩa Việt Nam là thành viên.";
MERGE (n:KhaiNiem {ten: "Kinh tế tuần hoàn"}) ON CREATE SET n.dieu_khoan = "Điều 142, Khoản 1", n.noi_dung = "là mô hình kinh tế trong đó các hoạt động thiết kế, sản xuất, tiêu dùng và dịch vụ nhằm giảm khai thác nguyên liệu, vật liệu, kéo dài vòng đời sản phẩm, hạn chế chất thải phát sinh và giảm thiểu tác động xấu đến môi trường.", n.chuong = "Chương XI", n.keyphrase = "Giảm khai thác nguyên liệu; Kéo dài vòng đời" ON MATCH SET n.dieu_khoan = "Điều 142, Khoản 1", n.noi_dung = "là mô hình kinh tế trong đó các hoạt động thiết kế, sản xuất, tiêu dùng và dịch vụ nhằm giảm khai thác nguyên liệu, vật liệu, kéo dài vòng đời sản phẩm, hạn chế chất thải phát sinh và giảm thiểu tác động xấu đến môi trường.";
MERGE (n:KhaiNiem {ten: "Công nghiệp môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 143, Khoản 1", n.noi_dung = "là ngành kinh tế trong hệ thống ngành kinh tế Việt Nam cung cấp công nghệ, thiết bị và sản phẩm phục vụ yêu cầu về bảo vệ môi trường.", n.chuong = "Chương XI", n.keyphrase = "Cung cấp công nghệ/thiết bị Bảo vệ môi trường" ON MATCH SET n.dieu_khoan = "Điều 143, Khoản 1", n.noi_dung = "là ngành kinh tế trong hệ thống ngành kinh tế Việt Nam cung cấp công nghệ, thiết bị và sản phẩm phục vụ yêu cầu về bảo vệ môi trường.";
MERGE (n:KhaiNiem {ten: "Dịch vụ môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 144, Khoản 1", n.noi_dung = "là ngành kinh tế cung cấp dịch vụ đo lường, kiểm soát, hạn chế, phòng ngừa và giảm thiểu ô nhiễm môi trường nước, không khí, đất và sử dụng hiệu quả tài nguyên thiên nhiên; xử lý chất thải, các chất ô nhiễm khác; bảo tồn đa dạng sinh học và các dịch vụ khác có liên quan.", n.chuong = "Chương XI", n.keyphrase = "Đo lường, kiểm soát, xử lý ô nhiễm" ON MATCH SET n.dieu_khoan = "Điều 144, Khoản 1", n.noi_dung = "là ngành kinh tế cung cấp dịch vụ đo lường, kiểm soát, hạn chế, phòng ngừa và giảm thiểu ô nhiễm môi trường nước, không khí, đất và sử dụng hiệu quả tài nguyên thiên nhiên; xử lý chất thải, các chất ô nhiễm khác; bảo tồn đa dạng sinh học và các dịch vụ khác có liên quan.";
MERGE (n:KhaiNiem {ten: "Sản phẩm, dịch vụ thân thiện môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 145, Khoản 1", n.noi_dung = "là sản phẩm, dịch vụ được tạo ra từ các nguyên liệu, vật liệu, công nghệ sản xuất và quản lý thân thiện môi trường, giảm tác động tiêu cực đến môi trường trong quá trình sử dụng, thải bỏ, bảo đảm an toàn cho môi trường, sức khỏe con người và được cơ quan có thẩm quyền chứng nhận hoặc công nhận.", n.chuong = "Chương XI", n.keyphrase = "Thân thiện môi trường; Được chứng nhận/công nhận" ON MATCH SET n.dieu_khoan = "Điều 145, Khoản 1", n.noi_dung = "là sản phẩm, dịch vụ được tạo ra từ các nguyên liệu, vật liệu, công nghệ sản xuất và quản lý thân thiện môi trường, giảm tác động tiêu cực đến môi trường trong quá trình sử dụng, thải bỏ, bảo đảm an toàn cho môi trường, sức khỏe con người và được cơ quan có thẩm quyền chứng nhận hoặc công nhận.";
MERGE (n:KhaiNiem {ten: "Nhãn sinh thái Việt Nam"}) ON CREATE SET n.dieu_khoan = "Điều 145, Khoản 2", n.noi_dung = "là nhãn được cơ quan có thẩm quyền của Việt Nam chứng nhận cho sản phẩm, dịch vụ thân thiện môi trường.", n.chuong = "Chương XI", n.keyphrase = "Nhãn chứng nhận thân thiện môi trường" ON MATCH SET n.dieu_khoan = "Điều 145, Khoản 2", n.noi_dung = "là nhãn được cơ quan có thẩm quyền của Việt Nam chứng nhận cho sản phẩm, dịch vụ thân thiện môi trường.";
MERGE (n:KhaiNiem {ten: "Mua sắm xanh"}) ON CREATE SET n.dieu_khoan = "Điều 146, Khoản 1", n.noi_dung = "là việc mua sắm các sản phẩm, dịch vụ thân thiện môi trường được chứng nhận Nhãn sinh thái Việt Nam hoặc được công nhận theo quy định của pháp luật.", n.chuong = "Chương XI", n.keyphrase = "Mua sắm sản phẩm/dịch vụ thân thiện môi trường" ON MATCH SET n.dieu_khoan = "Điều 146, Khoản 1", n.noi_dung = "là việc mua sắm các sản phẩm, dịch vụ thân thiện môi trường được chứng nhận Nhãn sinh thái Việt Nam hoặc được công nhận theo quy định của pháp luật.";
MERGE (n:KhaiNiem {ten: "Vốn tự nhiên"}) ON CREATE SET n.dieu_khoan = "Điều 147, Khoản 1", n.noi_dung = "là các nguồn tài nguyên thiên nhiên, gồm đất, nước, rừng, nguồn lợi thủy sản, khoáng sản, nhiên liệu hóa thạch, các nguồn năng lượng tự nhiên và các dịch vụ hệ sinh thái tự nhiên.", n.chuong = "Chương XI", n.keyphrase = "Nguồn tài nguyên thiên nhiên; Dịch vụ hệ sinh thái tự nhiên" ON MATCH SET n.dieu_khoan = "Điều 147, Khoản 1", n.noi_dung = "là các nguồn tài nguyên thiên nhiên, gồm đất, nước, rừng, nguồn lợi thủy sản, khoáng sản, nhiên liệu hóa thạch, các nguồn năng lượng tự nhiên và các dịch vụ hệ sinh thái tự nhiên.";
MERGE (n:KhaiNiem {ten: "Tín dụng xanh"}) ON CREATE SET n.dieu_khoan = "Điều 149, Khoản 1", n.noi_dung = "là tín dụng được cấp cho dự án đầu tư sử dụng hiệu quả tài nguyên thiên nhiên; ứng phó với biến đổi khí hậu; quản lý chất thải; xử lý ô nhiễm, cải thiện chất lượng môi trường; phục hồi hệ sinh thái tự nhiên; bảo tồn thiên nhiên và đa dạng sinh học; tạo ra lợi ích khác về môi trường.", n.chuong = "Chương XI", n.keyphrase = "Tín dụng cho ứng phó biến đổi khí hậu/quản lý chất thải" ON MATCH SET n.dieu_khoan = "Điều 149, Khoản 1", n.noi_dung = "là tín dụng được cấp cho dự án đầu tư sử dụng hiệu quả tài nguyên thiên nhiên; ứng phó với biến đổi khí hậu; quản lý chất thải; xử lý ô nhiễm, cải thiện chất lượng môi trường; phục hồi hệ sinh thái tự nhiên; bảo tồn thiên nhiên và đa dạng sinh học; tạo ra lợi ích khác về môi trường.";
MERGE (n:KhaiNiem {ten: "Trái phiếu xanh"}) ON CREATE SET n.dieu_khoan = "Điều 150, Khoản 1", n.noi_dung = "là trái phiếu do Chính phủ, chính quyền địa phương, doanh nghiệp phát hành theo quy định của pháp luật về trái phiếu để huy động vốn cho hoạt động bảo vệ môi trường, dự án đầu tư mang lại lợi ích về môi trường.", n.chuong = "Chương XI", n.keyphrase = "Trái phiếu huy động vốn bảo vệ môi trường" ON MATCH SET n.dieu_khoan = "Điều 150, Khoản 1", n.noi_dung = "là trái phiếu do Chính phủ, chính quyền địa phương, doanh nghiệp phát hành theo quy định của pháp luật về trái phiếu để huy động vốn cho hoạt động bảo vệ môi trường, dự án đầu tư mang lại lợi ích về môi trường.";
