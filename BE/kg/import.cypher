MERGE (n:KhaiNiem {ten: "Môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 1", n.noi_dung = "bao gồm các yếu tố vật chất tự nhiên và nhân tạo quan hệ mật thiết với nhau, bao quanh con người, có ảnh hưởng đến đời sống, kinh tế, xã hội, sự tồn tại, phát triển của con người, sinh vật và tự nhiên.", n.chuong = "Chương I", n.keyphrase = "Yếu tố vật chất tự nhiên và nhân tạo, bao quanh con người, ảnh hưởng đến đời sống." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 1", n.noi_dung = "bao gồm các yếu tố vật chất tự nhiên và nhân tạo quan hệ mật thiết với nhau, bao quanh con người, có ảnh hưởng đến đời sống, kinh tế, xã hội, sự tồn tại, phát triển của con người, sinh vật và tự nhiên.";
MERGE (n:KhaiNiem {ten: "Hoạt động bảo vệ môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 2", n.noi_dung = "là hoạt động phòng ngừa, hạn chế tác động xấu đến môi trường; ứng phó sự cố môi trường; khắc phục ô nhiễm, suy thoái môi trường, cải thiện chất lượng môi trường; sử dụng hợp lý tài nguyên thiên nhiên, đa dạng sinh học và ứng phó với biến đổi khí hậu.", n.chuong = "Chương I", n.keyphrase = "Phòng ngừa, hạn chế tác động xấu; ứng phó sự cố; khắc phục ô nhiễm; ứng phó biến đổi khí hậu." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 2", n.noi_dung = "là hoạt động phòng ngừa, hạn chế tác động xấu đến môi trường; ứng phó sự cố môi trường; khắc phục ô nhiễm, suy thoái môi trường, cải thiện chất lượng môi trường; sử dụng hợp lý tài nguyên thiên nhiên, đa dạng sinh học và ứng phó với biến đổi khí hậu.";
MERGE (n:KhaiNiem {ten: "Thành phần môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 3", n.noi_dung = "là yếu tố vật chất tạo thành môi trường gồm đất, nước, không khí, sinh vật, âm thanh, ánh sáng và các hình thái vật chất khác.", n.chuong = "Chương I", n.keyphrase = "Yếu tố vật chất tạo thành môi trường (đất, nước, không khí, sinh vật, âm thanh, ánh sáng)." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 3", n.noi_dung = "là yếu tố vật chất tạo thành môi trường gồm đất, nước, không khí, sinh vật, âm thanh, ánh sáng và các hình thái vật chất khác.";
MERGE (n:KhaiNiem {ten: "Quy hoạch bảo vệ môi trường quốc gia"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 4", n.noi_dung = "là việc sắp xếp, định hướng phân bố không gian phân vùng quản lý chất lượng môi trường, bảo tồn thiên nhiên và đa dạng sinh học, quản lý chất thải, quan trắc và cảnh báo môi trường trên lãnh thổ xác định để bảo vệ môi trường, phục vụ mục tiêu phát triển bền vững đất nước cho thời kỳ xác định.", n.chuong = "Chương I", n.keyphrase = "Sắp xếp không gian phân vùng quản lý chất lượng môi trường, phục vụ phát triển bền vững." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 4", n.noi_dung = "là việc sắp xếp, định hướng phân bố không gian phân vùng quản lý chất lượng môi trường, bảo tồn thiên nhiên và đa dạng sinh học, quản lý chất thải, quan trắc và cảnh báo môi trường trên lãnh thổ xác định để bảo vệ môi trường, phục vụ mục tiêu phát triển bền vững đất nước cho thời kỳ xác định.";
MERGE (n:KhaiNiem {ten: "Đánh giá môi trường chiến lược"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 5", n.noi_dung = "là quá trình nhận dạng, dự báo xu hướng của các vấn đề môi trường chính, làm cơ sở để tích hợp, lồng ghép giải pháp bảo vệ môi trường trong chính sách, chiến lược, quy hoạch.", n.chuong = "Chương I", n.keyphrase = "Nhận dạng, dự báo xu hướng của vấn đề môi trường, tích hợp giải pháp BVMT trong chính sách/chiến lược/quy hoạch." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 5", n.noi_dung = "là quá trình nhận dạng, dự báo xu hướng của các vấn đề môi trường chính, làm cơ sở để tích hợp, lồng ghép giải pháp bảo vệ môi trường trong chính sách, chiến lược, quy hoạch.";
MERGE (n:KhaiNiem {ten: "Đánh giá sơ bộ tác động môi trường (PEIA)"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 6", n.noi_dung = "là việc xem xét, nhận dạng các vấn đề môi trường chính của dự án đầu tư trong giai đoạn nghiên cứu tiền khả thi hoặc giai đoạn đề xuất thực hiện dự án đầu tư.", n.chuong = "Chương I", n.keyphrase = "Nhận dạng vấn đề môi trường trong giai đoạn nghiên cứu tiền khả thi." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 6", n.noi_dung = "là việc xem xét, nhận dạng các vấn đề môi trường chính của dự án đầu tư trong giai đoạn nghiên cứu tiền khả thi hoặc giai đoạn đề xuất thực hiện dự án đầu tư.";
MERGE (n:KhaiNiem {ten: "Đánh giá tác động môi trường (EIA/ĐTM)"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 7", n.noi_dung = "là quá trình phân tích, đánh giá, nhận dạng, dự báo tác động đến môi trường của dự án đầu tư và đưa ra biện pháp giảm thiểu tác động xấu đến môi trường.", n.chuong = "Chương I", n.keyphrase = "Phân tích, đánh giá, dự báo tác động đến môi trường của dự án đầu tư." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 7", n.noi_dung = "là quá trình phân tích, đánh giá, nhận dạng, dự báo tác động đến môi trường của dự án đầu tư và đưa ra biện pháp giảm thiểu tác động xấu đến môi trường.";
MERGE (n:KhaiNiem {ten: "Giấy phép môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 8", n.noi_dung = "là văn bản do cơ quan quản lý nhà nước có thẩm quyền cấp cho tổ chức, cá nhân có hoạt động sản xuất, kinh doanh, dịch vụ được phép xả chất thải ra môi trường, quản lý chất thải, nhập khẩu phế liệu từ nước ngoài làm nguyên liệu sản xuất kèm theo yêu cầu, điều kiện về bảo vệ môi trường theo quy định của pháp luật.", n.chuong = "Chương I", n.keyphrase = "Văn bản do cơ quan thẩm quyền cấp, cho phép xả chất thải, quản lý chất thải, nhập khẩu phế liệu." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 8", n.noi_dung = "là văn bản do cơ quan quản lý nhà nước có thẩm quyền cấp cho tổ chức, cá nhân có hoạt động sản xuất, kinh doanh, dịch vụ được phép xả chất thải ra môi trường, quản lý chất thải, nhập khẩu phế liệu từ nước ngoài làm nguyên liệu sản xuất kèm theo yêu cầu, điều kiện về bảo vệ môi trường theo quy định của pháp luật.";
MERGE (n:KhaiNiem {ten: "Đăng ký môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 9", n.noi_dung = "là việc chủ dự án đầu tư, cơ sở sản xuất, kinh doanh, dịch vụ thực hiện đăng ký với cơ quan quản lý nhà nước các nội dung liên quan đến xả chất thải và biện pháp bảo vệ môi trường của dự án đầu tư, cơ sở sản xuất, kinh doanh, dịch vụ (sau đây gọi chung là dự án đầu tư, cơ sở).", n.chuong = "Chương I", n.keyphrase = "Chủ dự án/cơ sở đăng ký với cơ quan nhà nước về xả chất thải và biện pháp BVMT." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 9", n.noi_dung = "là việc chủ dự án đầu tư, cơ sở sản xuất, kinh doanh, dịch vụ thực hiện đăng ký với cơ quan quản lý nhà nước các nội dung liên quan đến xả chất thải và biện pháp bảo vệ môi trường của dự án đầu tư, cơ sở sản xuất, kinh doanh, dịch vụ (sau đây gọi chung là dự án đầu tư, cơ sở).";
MERGE (n:KhaiNiem {ten: "Quy chuẩn kỹ thuật môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 10", n.noi_dung = "là quy định bắt buộc áp dụng mức giới hạn của thông số về chất lượng môi trường, hàm lượng của chất ô nhiễm có trong nguyên liệu, nhiên liệu, vật liệu, thiết bị, sản phẩm, hàng hóa, chất thải, các yêu cầu kỹ thuật và quản lý được cơ quan nhà nước có thẩm quyền ban hành theo quy định của pháp luật về tiêu chuẩn và quy chuẩn kỹ thuật.", n.chuong = "Chương I", n.keyphrase = "Quy định bắt buộc áp dụng mức giới hạn thông số, hàm lượng chất ô nhiễm." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 10", n.noi_dung = "là quy định bắt buộc áp dụng mức giới hạn của thông số về chất lượng môi trường, hàm lượng của chất ô nhiễm có trong nguyên liệu, nhiên liệu, vật liệu, thiết bị, sản phẩm, hàng hóa, chất thải, các yêu cầu kỹ thuật và quản lý được cơ quan nhà nước có thẩm quyền ban hành theo quy định của pháp luật về tiêu chuẩn và quy chuẩn kỹ thuật.";
MERGE (n:KhaiNiem {ten: "Tiêu chuẩn môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 11", n.noi_dung = "là quy định tự nguyện áp dụng mức giới hạn của thông số về chất lượng môi trường, hàm lượng của chất ô nhiễm có trong chất thải, các yêu cầu kỹ thuật và quản lý được cơ quan nhà nước có thẩm quyền hoặc tổ chức công bố theo quy định của pháp luật về tiêu chuẩn và quy chuẩn kỹ thuật.", n.chuong = "Chương I", n.keyphrase = "Quy định tự nguyện áp dụng mức giới hạn thông số." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 11", n.noi_dung = "là quy định tự nguyện áp dụng mức giới hạn của thông số về chất lượng môi trường, hàm lượng của chất ô nhiễm có trong chất thải, các yêu cầu kỹ thuật và quản lý được cơ quan nhà nước có thẩm quyền hoặc tổ chức công bố theo quy định của pháp luật về tiêu chuẩn và quy chuẩn kỹ thuật.";
MERGE (n:KhaiNiem {ten: "Ô nhiễm môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 12", n.noi_dung = "là sự biến đổi tính chất vật lý, hóa học, sinh học của thành phần môi trường không phù hợp với quy chuẩn kỹ thuật môi trường, tiêu chuẩn môi trường gây ảnh hưởng xấu đến sức khỏe con người, sinh vật và tự nhiên.", n.chuong = "Chương I", n.keyphrase = "Biến đổi tính chất không phù hợp quy chuẩn/tiêu chuẩn, gây ảnh hưởng xấu." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 12", n.noi_dung = "là sự biến đổi tính chất vật lý, hóa học, sinh học của thành phần môi trường không phù hợp với quy chuẩn kỹ thuật môi trường, tiêu chuẩn môi trường gây ảnh hưởng xấu đến sức khỏe con người, sinh vật và tự nhiên.";
MERGE (n:KhaiNiem {ten: "Suy thoái môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 13", n.noi_dung = "là sự suy giảm về chất lượng, số lượng của thành phần môi trường, gây ảnh hưởng xấu đến sức khỏe con người, sinh vật và tự nhiên.", n.chuong = "Chương I", n.keyphrase = "Suy giảm chất lượng, số lượng thành phần môi trường, gây ảnh hưởng xấu." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 13", n.noi_dung = "là sự suy giảm về chất lượng, số lượng của thành phần môi trường, gây ảnh hưởng xấu đến sức khỏe con người, sinh vật và tự nhiên.";
MERGE (n:KhaiNiem {ten: "Sự cố môi trường"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 14", n.noi_dung = "là sự cố xảy ra trong quá trình hoạt động của con người hoặc do biến đổi bất thường của tự nhiên, gây ô nhiễm, suy thoái môi trường nghiêm trọng.", n.chuong = "Chương I", n.keyphrase = "Sự cố gây ô nhiễm, suy thoái môi trường nghiêm trọng." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 14", n.noi_dung = "là sự cố xảy ra trong quá trình hoạt động của con người hoặc do biến đổi bất thường của tự nhiên, gây ô nhiễm, suy thoái môi trường nghiêm trọng.";
MERGE (n:KhaiNiem {ten: "Chất ô nhiễm"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 15", n.noi_dung = "là chất hóa học hoặc tác nhân vật lý, sinh học mà khi xuất hiện trong môi trường vượt mức cho phép sẽ gây ô nhiễm môi trường.", n.chuong = "Chương I", n.keyphrase = "Chất/tác nhân vượt mức cho phép gây ô nhiễm." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 15", n.noi_dung = "là chất hóa học hoặc tác nhân vật lý, sinh học mà khi xuất hiện trong môi trường vượt mức cho phép sẽ gây ô nhiễm môi trường.";
MERGE (n:KhaiNiem {ten: "Chất ô nhiễm khó phân hủy"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 16", n.noi_dung = "là chất ô nhiễm có độc tính cao, khó phân hủy, có khả năng tích lũy sinh học và lan truyền trong môi trường, tác động xấu đến môi trường và sức khỏe con người.", n.chuong = "Chương I", n.keyphrase = "Độc tính cao, khó phân hủy, tích lũy sinh học, lan truyền." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 16", n.noi_dung = "là chất ô nhiễm có độc tính cao, khó phân hủy, có khả năng tích lũy sinh học và lan truyền trong môi trường, tác động xấu đến môi trường và sức khỏe con người.";
MERGE (n:KhaiNiem {ten: "Chất ô nhiễm hữu cơ khó phân hủy"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 17", n.noi_dung = "là chất ô nhiễm khó phân hủy được quy định trong Công ước Stockholm về các chất ô nhiễm hữu cơ khó phân hủy (sau đây gọi là Công ước Stockholm).", n.chuong = "Chương I", n.keyphrase = "Chất ô nhiễm khó phân hủy theo Công ước Stockholm." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 17", n.noi_dung = "là chất ô nhiễm khó phân hủy được quy định trong Công ước Stockholm về các chất ô nhiễm hữu cơ khó phân hủy (sau đây gọi là Công ước Stockholm).";
MERGE (n:KhaiNiem {ten: "Chất thải"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 18", n.noi_dung = "là vật chất ở thể rắn, lỏng, khí hoặc ở dạng khác được thải ra từ hoạt động sản xuất, kinh doanh, dịch vụ, sinh hoạt hoặc hoạt động khác.", n.chuong = "Chương I", n.keyphrase = "Vật chất thải ra từ hoạt động sản xuất, sinh hoạt (rắn, lỏng, khí)." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 18", n.noi_dung = "là vật chất ở thể rắn, lỏng, khí hoặc ở dạng khác được thải ra từ hoạt động sản xuất, kinh doanh, dịch vụ, sinh hoạt hoặc hoạt động khác.";
MERGE (n:KhaiNiem {ten: "Chất thải rắn"}) ON CREATE SET n.dieu_khoan = "Điều 3, Khoản 19", n.noi_dung = "là chất thải ở thể rắn hoặc bùn thải.", n.chuong = "Chương I", n.keyphrase = "Chất thải ở thể rắn hoặc bùn thải." ON MATCH SET n.dieu_khoan = "Điều 3, Khoản 19", n.noi_dung = "là chất thải ở thể rắn hoặc bùn thải.";
