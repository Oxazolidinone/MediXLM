MERGE (n:KhaiNiem {ten: "Hạn ngạch phát thải khí nhà kính"}) ON CREATE SET n.noi_dung = "là lượng khí nhà kính của quốc gia, tổ chức, cá nhân được phép phát thải trong một khoảng thời gian xác định, được tính theo tấn khí carbon dioxide (CO2​) hoặc tấn khí carbon dioxide (CO2​) tương đương.", n.keyphrase = "Lượng KNK được phép phát thải theo tấn CO2​ tương đương." ON MATCH SET n.noi_dung = "là lượng khí nhà kính của quốc gia, tổ chức, cá nhân được phép phát thải trong một khoảng thời gian xác định, được tính theo tấn khí carbon dioxide (CO2​) hoặc tấn khí carbon dioxide (CO2​) tương đương.";
