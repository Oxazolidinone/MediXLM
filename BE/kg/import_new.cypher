MERGE (n:KhaiNiem {ten: "Chất thải"}) ON CREATE SET n.noi_dung = "là vật chất ở thể rắn, lỏng, khí hoặc ở dạng khác được thải ra từ hoạt động sản xuất, kinh doanh, dịch vụ, sinh hoạt hoặc hoạt động khác.", n.keyphrase = "Vật chất thải ra từ hoạt động sản xuất, sinh hoạt (rắn, lỏng, khí)." ON MATCH SET n.noi_dung = "là vật chất ở thể rắn, lỏng, khí hoặc ở dạng khác được thải ra từ hoạt động sản xuất, kinh doanh, dịch vụ, sinh hoạt hoặc hoạt động khác.";
