MERGE (n:KhaiNiem {ten: "Chất ô nhiễm hữu cơ khó phân hủy"}) ON CREATE SET n.noi_dung = "là chất ô nhiễm khó phân hủy được quy định trong Công ước Stockholm về các chất ô nhiễm hữu cơ khó phân hủy (sau đây gọi là Công ước Stockholm).", n.keyphrase = "Chất ô nhiễm khó phân hủy theo Công ước Stockholm." ON MATCH SET n.noi_dung = "là chất ô nhiễm khó phân hủy được quy định trong Công ước Stockholm về các chất ô nhiễm hữu cơ khó phân hủy (sau đây gọi là Công ước Stockholm).";
