MERGE (n:KhaiNiem {ten: "Vận hành thử nghiệm công trình xử lý chất thải"}) ON CREATE SET n.noi_dung = "là việc vận hành nhằm kiểm tra, đánh giá hiệu quả và sự phù hợp với yêu cầu về bảo vệ môi trường đối với công trình xử lý chất thải của chủ dự án đầu tư, cơ sở, khu sản xuất, kinh doanh, dịch vụ tập trung, cụm công nghiệp.", n.keyphrase = "Vận hành kiểm tra, đánh giá hiệu quả công trình xử lý chất thải." ON MATCH SET n.noi_dung = "là việc vận hành nhằm kiểm tra, đánh giá hiệu quả và sự phù hợp với yêu cầu về bảo vệ môi trường đối với công trình xử lý chất thải của chủ dự án đầu tư, cơ sở, khu sản xuất, kinh doanh, dịch vụ tập trung, cụm công nghiệp.";
