MERGE (n:KhaiNiem {ten: "Tiêu chuẩn môi trường"}) MERGE (dl:DieuLuat {id: "id_fec8a4bd1eed"}) MERGE (n)-[:QUY_DINH_TAI]->(dl);
MERGE (ch:Chuong {id: "id_755eb599812e"}) ON CREATE SET ch.ten = "Chương I";
MERGE (dl:DieuLuat {id: "id_fec8a4bd1eed"}) MERGE (ch:Chuong {id: "id_755eb599812e"}) MERGE (dl)-[:THUOC_CHUONG]->(ch);
MERGE (n:KhaiNiem {ten: "Ô nhiễm môi trường"}) ON CREATE SET n.noi_dung = "là sự biến đổi tính chất vật lý, hóa học, sinh học của thành phần môi trường không phù hợp với quy chuẩn kỹ thuật môi trường, tiêu chuẩn môi trường gây ảnh hưởng xấu đến sức khỏe con người, sinh vật và tự nhiên.", n.keyphrase = "Biến đổi tính chất không phù hợp quy chuẩn/tiêu chuẩn, gây ảnh hưởng xấu." ON MATCH SET n.noi_dung = "là sự biến đổi tính chất vật lý, hóa học, sinh học của thành phần môi trường không phù hợp với quy chuẩn kỹ thuật môi trường, tiêu chuẩn môi trường gây ảnh hưởng xấu đến sức khỏe con người, sinh vật và tự nhiên.";
MERGE (dl:DieuLuat {id: "id_55ea5aa2fc5c"}) ON CREATE SET dl.ten = "Điều 3, Khoản 12";
