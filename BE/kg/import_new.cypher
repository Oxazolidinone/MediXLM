MERGE (dl:DieuLuat {id: "id_b903113672ae"}) MERGE (ch:Chuong {id: "id_755eb599812e"}) MERGE (dl)-[:THUOC_CHUONG]->(ch);
MERGE (n:KhaiNiem {ten: "Giấy phép môi trường"}) ON CREATE SET n.noi_dung = "là văn bản do cơ quan quản lý nhà nước có thẩm quyền cấp cho tổ chức, cá nhân có hoạt động sản xuất, kinh doanh, dịch vụ được phép xả chất thải ra môi trường, quản lý chất thải, nhập khẩu phế liệu từ nước ngoài làm nguyên liệu sản xuất kèm theo yêu cầu, điều kiện về bảo vệ môi trường theo quy định của pháp luật.", n.keyphrase = "Văn bản do cơ quan thẩm quyền cấp, cho phép xả chất thải, quản lý chất thải, nhập khẩu phế liệu." ON MATCH SET n.noi_dung = "là văn bản do cơ quan quản lý nhà nước có thẩm quyền cấp cho tổ chức, cá nhân có hoạt động sản xuất, kinh doanh, dịch vụ được phép xả chất thải ra môi trường, quản lý chất thải, nhập khẩu phế liệu từ nước ngoài làm nguyên liệu sản xuất kèm theo yêu cầu, điều kiện về bảo vệ môi trường theo quy định của pháp luật.";
MERGE (dl:DieuLuat {id: "id_26c01d357cf2"}) ON CREATE SET dl.ten = "Điều 3, Khoản 8";
