MERGE (n:KhaiNiem {ten: "Hiệu ứng nhà kính"}) ON CREATE SET n.noi_dung = "là hiện tượng năng lượng bức xạ của Mặt Trời được hấp thụ trong khí quyển, chuyển hóa thành nhiệt lượng gây hiện tượng nóng lên toàn cầu.", n.keyphrase = "Năng lượng bức xạ chuyển hóa thành nhiệt lượng gây nóng lên toàn cầu." ON MATCH SET n.noi_dung = "là hiện tượng năng lượng bức xạ của Mặt Trời được hấp thụ trong khí quyển, chuyển hóa thành nhiệt lượng gây hiện tượng nóng lên toàn cầu.";
