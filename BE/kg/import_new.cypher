MERGE (n:KhaiNiem {ten: "Kỹ thuật hiện có tốt nhất"}) ON CREATE SET n.noi_dung = "là giải pháp kỹ thuật tốt nhất được lựa chọn bảo đảm phù hợp với thực tế, hiệu quả trong phòng ngừa, kiểm soát ô nhiễm, giảm thiểu tác động xấu đến môi trường.", n.keyphrase = "Giải pháp kỹ thuật tốt nhất để phòng ngừa, kiểm soát ô nhiễm." ON MATCH SET n.noi_dung = "là giải pháp kỹ thuật tốt nhất được lựa chọn bảo đảm phù hợp với thực tế, hiệu quả trong phòng ngừa, kiểm soát ô nhiễm, giảm thiểu tác động xấu đến môi trường.";
