MERGE (n:KhaiNiem {ten: "Tầng ô-dôn"}) ON CREATE SET n.noi_dung = "là một lớp trong tầng bình lưu của Trái Đất, có tác dụng bảo vệ Trái Đất khỏi các bức xạ cực tím có hại từ Mặt Trời.", n.keyphrase = "Lớp trong tầng bình lưu, bảo vệ khỏi bức xạ cực tím." ON MATCH SET n.noi_dung = "là một lớp trong tầng bình lưu của Trái Đất, có tác dụng bảo vệ Trái Đất khỏi các bức xạ cực tím có hại từ Mặt Trời.";
