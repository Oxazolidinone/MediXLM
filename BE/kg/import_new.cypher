MERGE (dl:DieuLuat {id: "id_df7ae9401d12"}) MERGE (ch:Chuong {id: "id_755eb599812e"}) MERGE (dl)-[:THUOC_CHUONG]->(ch);
MERGE (n:KhaiNiem {ten: "Thành phần môi trường"}) ON CREATE SET n.noi_dung = "là yếu tố vật chất tạo thành môi trường gồm đất, nước, không khí, sinh vật, âm thanh, ánh sáng và các hình thái vật chất khác.", n.keyphrase = "Yếu tố vật chất tạo thành môi trường (đất, nước, không khí, sinh vật, âm thanh, ánh sáng)." ON MATCH SET n.noi_dung = "là yếu tố vật chất tạo thành môi trường gồm đất, nước, không khí, sinh vật, âm thanh, ánh sáng và các hình thái vật chất khác.";
MERGE (dl:DieuLuat {id: "id_cc1ca2bd00b3"}) ON CREATE SET dl.ten = "Điều 3, Khoản 3";
MERGE (n:KhaiNiem {ten: "Thành phần môi trường"}) MERGE (dl:DieuLuat {id: "id_cc1ca2bd00b3"}) MERGE (n)-[:QUY_DINH_TAI]->(dl);
