MERGE (n:KhaiNiem {ten: "Chất ô nhiễm khó phân hủy"}) ON CREATE SET n.noi_dung = "là chất ô nhiễm có độc tính cao, khó phân hủy, có khả năng tích lũy sinh học và lan truyền trong môi trường, tác động xấu đến môi trường và sức khỏe con người.", n.keyphrase = "Độc tính cao, khó phân hủy, tích lũy sinh học, lan truyền." ON MATCH SET n.noi_dung = "là chất ô nhiễm có độc tính cao, khó phân hủy, có khả năng tích lũy sinh học và lan truyền trong môi trường, tác động xấu đến môi trường và sức khỏe con người.";
