MERGE (dl:DieuLuat {id: "id_cc1ca2bd00b3"}) MERGE (ch:Chuong {id: "id_755eb599812e"}) MERGE (dl)-[:THUOC_CHUONG]->(ch);
MERGE (n:KhaiNiem {ten: "Quy hoạch bảo vệ môi trường quốc gia"}) ON CREATE SET n.noi_dung = "là việc sắp xếp, định hướng phân bố không gian phân vùng quản lý chất lượng môi trường, bảo tồn thiên nhiên và đa dạng sinh học, quản lý chất thải, quan trắc và cảnh báo môi trường trên lãnh thổ xác định để bảo vệ môi trường, phục vụ mục tiêu phát triển bền vững đất nước cho thời kỳ xác định.", n.keyphrase = "Sắp xếp không gian phân vùng quản lý chất lượng môi trường, phục vụ phát triển bền vững." ON MATCH SET n.noi_dung = "là việc sắp xếp, định hướng phân bố không gian phân vùng quản lý chất lượng môi trường, bảo tồn thiên nhiên và đa dạng sinh học, quản lý chất thải, quan trắc và cảnh báo môi trường trên lãnh thổ xác định để bảo vệ môi trường, phục vụ mục tiêu phát triển bền vững đất nước cho thời kỳ xác định.";
MERGE (dl:DieuLuat {id: "id_6782082651c6"}) ON CREATE SET dl.ten = "Điều 3, Khoản 4";
MERGE (n:KhaiNiem {ten: "Quy hoạch bảo vệ môi trường quốc gia"}) MERGE (dl:DieuLuat {id: "id_6782082651c6"}) MERGE (n)-[:QUY_DINH_TAI]->(dl);
