MERGE (n:KhaiNiem {ten: "Môi trường"}) ON CREATE SET n.noi_dung = "bao gồm các yếu tố vật chất tự nhiên và nhân tạo quan hệ mật thiết với nhau, bao quanh con người, có ảnh hưởng đến đời sống, kinh tế, xã hội, sự tồn tại, phát triển của con người, sinh vật và tự nhiên.", n.keyphrase = "Yếu tố vật chất tự nhiên và nhân tạo, bao quanh con người, ảnh hưởng đến đời sống." ON MATCH SET n.noi_dung = "bao gồm các yếu tố vật chất tự nhiên và nhân tạo quan hệ mật thiết với nhau, bao quanh con người, có ảnh hưởng đến đời sống, kinh tế, xã hội, sự tồn tại, phát triển của con người, sinh vật và tự nhiên.";
MERGE (dl:DieuLuat {id: "id_b7895b4979cb"}) ON CREATE SET dl.ten = "Điều 3, Khoản 1";
MERGE (n:KhaiNiem {ten: "Môi trường"}) MERGE (dl:DieuLuat {id: "id_b7895b4979cb"}) MERGE (n)-[:QUY_DINH_TAI]->(dl);
