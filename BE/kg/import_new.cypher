MERGE (dl:DieuLuat {id: "id_eae336307c06"}) MERGE (ch:Chuong {id: "id_755eb599812e"}) MERGE (dl)-[:THUOC_CHUONG]->(ch);
MERGE (n:KhaiNiem {ten: "Quy chuẩn kỹ thuật môi trường"}) ON CREATE SET n.noi_dung = "là quy định bắt buộc áp dụng mức giới hạn của thông số về chất lượng môi trường, hàm lượng của chất ô nhiễm có trong nguyên liệu, nhiên liệu, vật liệu, thiết bị, sản phẩm, hàng hóa, chất thải, các yêu cầu kỹ thuật và quản lý được cơ quan nhà nước có thẩm quyền ban hành theo quy định của pháp luật về tiêu chuẩn và quy chuẩn kỹ thuật.", n.keyphrase = "Quy định bắt buộc áp dụng mức giới hạn thông số, hàm lượng chất ô nhiễm." ON MATCH SET n.noi_dung = "là quy định bắt buộc áp dụng mức giới hạn của thông số về chất lượng môi trường, hàm lượng của chất ô nhiễm có trong nguyên liệu, nhiên liệu, vật liệu, thiết bị, sản phẩm, hàng hóa, chất thải, các yêu cầu kỹ thuật và quản lý được cơ quan nhà nước có thẩm quyền ban hành theo quy định của pháp luật về tiêu chuẩn và quy chuẩn kỹ thuật.";
MERGE (dl:DieuLuat {id: "id_5f661275b992"}) ON CREATE SET dl.ten = "Điều 3, Khoản 10";
MERGE (n:KhaiNiem {ten: "Quy chuẩn kỹ thuật môi trường"}) MERGE (dl:DieuLuat {id: "id_5f661275b992"}) MERGE (n)-[:QUY_DINH_TAI]->(dl);
MERGE (ch:Chuong {id: "id_755eb599812e"}) ON CREATE SET ch.ten = "Chương I";
MERGE (dl:DieuLuat {id: "id_5f661275b992"}) MERGE (ch:Chuong {id: "id_755eb599812e"}) MERGE (dl)-[:THUOC_CHUONG]->(ch);
MERGE (n:KhaiNiem {ten: "Tiêu chuẩn môi trường"}) ON CREATE SET n.noi_dung = "là quy định tự nguyện áp dụng mức giới hạn của thông số về chất lượng môi trường, hàm lượng của chất ô nhiễm có trong chất thải, các yêu cầu kỹ thuật và quản lý được cơ quan nhà nước có thẩm quyền hoặc tổ chức công bố theo quy định của pháp luật về tiêu chuẩn và quy chuẩn kỹ thuật.", n.keyphrase = "Quy định tự nguyện áp dụng mức giới hạn thông số." ON MATCH SET n.noi_dung = "là quy định tự nguyện áp dụng mức giới hạn của thông số về chất lượng môi trường, hàm lượng của chất ô nhiễm có trong chất thải, các yêu cầu kỹ thuật và quản lý được cơ quan nhà nước có thẩm quyền hoặc tổ chức công bố theo quy định của pháp luật về tiêu chuẩn và quy chuẩn kỹ thuật.";
