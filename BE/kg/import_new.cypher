MERGE (tn:TrachNhiem {id: "id_132109108eca"}) ON CREATE SET tn.ten = "Xây dựng quy định và cấp phép", tn.noi_dung = "Xây dựng, ban hành hoặc trình Hội đồng nhân dân cùng cấp ban hành văn bản quy phạm pháp luật; tiêu chuẩn, quy chuẩn kỹ thuật môi trường địa phương; tổ chức thẩm định ĐTM, cấp, cấp đổi, điều chỉnh, cấp lại giấy phép môi trường theo thẩm quyền.";
