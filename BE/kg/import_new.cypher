MERGE (n:KhaiNiem {ten: "Giảm nhẹ phát thải khí nhà kính"}) ON CREATE SET n.noi_dung = "là hoạt động nhằm giảm nhẹ mức độ hoặc cường độ phát thải khí nhà kính, tăng cường hấp thụ khí nhà kính.", n.keyphrase = "Giảm cường độ phát thải, tăng cường hấp thụ KNK." ON MATCH SET n.noi_dung = "là hoạt động nhằm giảm nhẹ mức độ hoặc cường độ phát thải khí nhà kính, tăng cường hấp thụ khí nhà kính.";
