MERGE (dl:DieuLuat {id: "id_c5117a1de12c"}) MERGE (ch:Chuong {id: "id_755eb599812e"}) MERGE (dl)-[:THUOC_CHUONG]->(ch);
MERGE (n:KhaiNiem {ten: "Đánh giá tác động môi trường (EIA/ĐTM)"}) ON CREATE SET n.noi_dung = "là quá trình phân tích, đánh giá, nhận dạng, dự báo tác động đến môi trường của dự án đầu tư và đưa ra biện pháp giảm thiểu tác động xấu đến môi trường.", n.keyphrase = "Phân tích, đánh giá, dự báo tác động đến môi trường của dự án đầu tư." ON MATCH SET n.noi_dung = "là quá trình phân tích, đánh giá, nhận dạng, dự báo tác động đến môi trường của dự án đầu tư và đưa ra biện pháp giảm thiểu tác động xấu đến môi trường.";
