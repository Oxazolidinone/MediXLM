MERGE (tn:TrachNhiem {id: "id_87bb0ae5217e"}) ON CREATE SET tn.ten = "Quản lý chất thải sinh hoạt", tn.noi_dung = "Quy định chi tiết về quản lý chất thải rắn sinh hoạt của hộ gia đình, cá nhân; quy định giá cụ thể đối với dịch vụ thu gom, vận chuyển và xử lý chất thải rắn sinh hoạt.";
