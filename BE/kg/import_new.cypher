MERGE (dl:DieuLuat {id: "id_6782082651c6"}) MERGE (ch:Chuong {id: "id_755eb599812e"}) MERGE (dl)-[:THUOC_CHUONG]->(ch);
MERGE (n:KhaiNiem {ten: "Đánh giá môi trường chiến lược"}) ON CREATE SET n.noi_dung = "là quá trình nhận dạng, dự báo xu hướng của các vấn đề môi trường chính, làm cơ sở để tích hợp, lồng ghép giải pháp bảo vệ môi trường trong chính sách, chiến lược, quy hoạch.", n.keyphrase = "Nhận dạng, dự báo xu hướng của vấn đề môi trường, tích hợp giải pháp BVMT trong chính sách/chiến lược/quy hoạch." ON MATCH SET n.noi_dung = "là quá trình nhận dạng, dự báo xu hướng của các vấn đề môi trường chính, làm cơ sở để tích hợp, lồng ghép giải pháp bảo vệ môi trường trong chính sách, chiến lược, quy hoạch.";
MERGE (dl:DieuLuat {id: "id_8bed969a4fab"}) ON CREATE SET dl.ten = "Điều 3, Khoản 5";
MERGE (n:KhaiNiem {ten: "Đánh giá môi trường chiến lược"}) MERGE (dl:DieuLuat {id: "id_8bed969a4fab"}) MERGE (n)-[:QUY_DINH_TAI]->(dl);
MERGE (ch:Chuong {id: "id_755eb599812e"}) ON CREATE SET ch.ten = "Chương I";
MERGE (dl:DieuLuat {id: "id_8bed969a4fab"}) MERGE (ch:Chuong {id: "id_755eb599812e"}) MERGE (dl)-[:THUOC_CHUONG]->(ch);
MERGE (n:KhaiNiem {ten: "Đánh giá sơ bộ tác động môi trường (PEIA)"}) ON CREATE SET n.noi_dung = "là việc xem xét, nhận dạng các vấn đề môi trường chính của dự án đầu tư trong giai đoạn nghiên cứu tiền khả thi hoặc giai đoạn đề xuất thực hiện dự án đầu tư.", n.keyphrase = "Nhận dạng vấn đề môi trường trong giai đoạn nghiên cứu tiền khả thi." ON MATCH SET n.noi_dung = "là việc xem xét, nhận dạng các vấn đề môi trường chính của dự án đầu tư trong giai đoạn nghiên cứu tiền khả thi hoặc giai đoạn đề xuất thực hiện dự án đầu tư.";
MERGE (dl:DieuLuat {id: "id_c5117a1de12c"}) ON CREATE SET dl.ten = "Điều 3, Khoản 6";
