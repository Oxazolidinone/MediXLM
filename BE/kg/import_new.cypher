MERGE (dl:DieuLuat {id: "id_b7895b4979cb"}) MERGE (ch:Chuong {id: "id_755eb599812e"}) MERGE (dl)-[:THUOC_CHUONG]->(ch);
MERGE (n:KhaiNiem {ten: "Hoạt động bảo vệ môi trường"}) ON CREATE SET n.noi_dung = "là hoạt động phòng ngừa, hạn chế tác động xấu đến môi trường; ứng phó sự cố môi trường; khắc phục ô nhiễm, suy thoái môi trường, cải thiện chất lượng môi trường; sử dụng hợp lý tài nguyên thiên nhiên, đa dạng sinh học và ứng phó với biến đổi khí hậu.", n.keyphrase = "Phòng ngừa, hạn chế tác động xấu; ứng phó sự cố; khắc phục ô nhiễm; ứng phó biến đổi khí hậu." ON MATCH SET n.noi_dung = "là hoạt động phòng ngừa, hạn chế tác động xấu đến môi trường; ứng phó sự cố môi trường; khắc phục ô nhiễm, suy thoái môi trường, cải thiện chất lượng môi trường; sử dụng hợp lý tài nguyên thiên nhiên, đa dạng sinh học và ứng phó với biến đổi khí hậu.";
MERGE (dl:DieuLuat {id: "id_df7ae9401d12"}) ON CREATE SET dl.ten = "Điều 3, Khoản 2";
MERGE (n:KhaiNiem {ten: "Hoạt động bảo vệ môi trường"}) MERGE (dl:DieuLuat {id: "id_df7ae9401d12"}) MERGE (n)-[:QUY_DINH_TAI]->(dl);
