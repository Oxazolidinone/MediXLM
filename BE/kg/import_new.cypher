MERGE (n:KhaiNiem {ten: "Quan trắc môi trường"}) ON CREATE SET n.noi_dung = "là việc theo dõi liên tục, định kỳ, đột xuất, có hệ thống về thành phần môi trường, các nhân tố tác động đến môi trường, chất thải nhằm cung cấp thông tin đánh giá hiện trạng môi trường, diễn biến chất lượng môi trường và tác động xấu đến môi trường.", n.keyphrase = "Theo dõi liên tục, định kỳ, đột xuất thành phần môi trường/chất thải." ON MATCH SET n.noi_dung = "là việc theo dõi liên tục, định kỳ, đột xuất, có hệ thống về thành phần môi trường, các nhân tố tác động đến môi trường, chất thải nhằm cung cấp thông tin đánh giá hiện trạng môi trường, diễn biến chất lượng môi trường và tác động xấu đến môi trường.";
