MERGE (n:KhaiNiem {ten: "Sản phẩm, dịch vụ thân thiện môi trường"}) ON CREATE SET n.noi_dung = "là sản phẩm, dịch vụ được tạo ra từ các nguyên liệu, vật liệu, công nghệ sản xuất và quản lý thân thiện môi trường, giảm tác động tiêu cực đến môi trường trong quá trình sử dụng, thải bỏ, bảo đảm an toàn cho môi trường, sức khỏe con người và được cơ quan có thẩm quyền chứng nhận hoặc công nhận.", n.keyphrase = "Thân thiện môi trường; Được chứng nhận/công nhận" ON MATCH SET n.noi_dung = "là sản phẩm, dịch vụ được tạo ra từ các nguyên liệu, vật liệu, công nghệ sản xuất và quản lý thân thiện môi trường, giảm tác động tiêu cực đến môi trường trong quá trình sử dụng, thải bỏ, bảo đảm an toàn cho môi trường, sức khỏe con người và được cơ quan có thẩm quyền chứng nhận hoặc công nhận.";
