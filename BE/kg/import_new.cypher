MERGE (n:KhaiNiem {ten: "Cộng đồng dân cư"}) ON CREATE SET n.noi_dung = "là cộng đồng người sinh sống trên cùng địa bàn thôn, ấp, bản, làng, buôn, bon, phum, sóc, tổ dân phố hoặc điểm dân cư tương tự trên lãnh thổ nước Cộng hòa xã hội chủ nghĩa Việt Nam.", n.keyphrase = "Cộng đồng người sinh sống trên cùng địa bàn (thôn, ấp, tổ dân phố, v.v.)." ON MATCH SET n.noi_dung = "là cộng đồng người sinh sống trên cùng địa bàn thôn, ấp, bản, làng, buôn, bon, phum, sóc, tổ dân phố hoặc điểm dân cư tương tự trên lãnh thổ nước Cộng hòa xã hội chủ nghĩa Việt Nam.";
