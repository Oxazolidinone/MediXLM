MERGE (n:KhaiNiem {ten: "Kiểm toán môi trường"}) ON CREATE SET n.noi_dung = "là việc xem xét, đánh giá có hệ thống, toàn diện hiệu quả quản lý môi trường, kiểm soát ô nhiễm của cơ sở sản xuất, kinh doanh, dịch vụ.", n.keyphrase = "Đánh giá có hệ thống, toàn diện; Hiệu quả quản lý môi trường" ON MATCH SET n.noi_dung = "là việc xem xét, đánh giá có hệ thống, toàn diện hiệu quả quản lý môi trường, kiểm soát ô nhiễm của cơ sở sản xuất, kinh doanh, dịch vụ.";
