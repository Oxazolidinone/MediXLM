MERGE (n:KhaiNiem {ten: "Sự cố môi trường"}) ON CREATE SET n.noi_dung = "là sự cố xảy ra trong quá trình hoạt động của con người hoặc do biến đổi bất thường của tự nhiên, gây ô nhiễm, suy thoái môi trường nghiêm trọng.", n.keyphrase = "Sự cố gây ô nhiễm, suy thoái môi trường nghiêm trọng." ON MATCH SET n.noi_dung = "là sự cố xảy ra trong quá trình hoạt động của con người hoặc do biến đổi bất thường của tự nhiên, gây ô nhiễm, suy thoái môi trường nghiêm trọng.";
